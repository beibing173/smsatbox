<Window x:Class="SmsatBox.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:pages="clr-namespace:SmsatBox.Desktop.Views.Pages"
        Title="SMSATBOX"
        Width="1180" Height="760"
        MinWidth="920" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.WindowBg}"
        FontFamily="{DynamicResource Font.Ui}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="228" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ================= 左侧导航 ================= -->
        <Border Grid.Column="0" Background="{DynamicResource Brush.NavBg}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 品牌 -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="18,22,18,18">
                    <Border Width="38" Height="38" CornerRadius="11" Background="{DynamicResource Brush.Accent}">
                        <TextBlock Text="📨" FontSize="19" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="SMSATBOX" FontSize="16" FontWeight="Bold"
                                   Foreground="{DynamicResource Brush.Text}" />
                        <TextBlock Text="多卡提醒盒子" Style="{StaticResource Text.Muted}" Margin="0,1,0,0" />
                    </StackPanel>
                </StackPanel>

                <!-- 连接状态 -->
                <Border Grid.Row="1" Margin="14,0,14,14" CornerRadius="10" Padding="12,9"
                        Background="{DynamicResource Brush.SurfaceAlt}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{DynamicResource Brush.TextMuted}"
                                     VerticalAlignment="Center" />
                            <TextBlock x:Name="StatusText" Style="{StaticResource Text.Sub}" Margin="7,0,0,0"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <TextBlock x:Name="UserText" Style="{StaticResource Text.Muted}" Margin="0,5,0,0"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>

                <!-- 三个导航项 -->
                <StackPanel Grid.Row="2">
                    <RadioButton x:Name="NavMessages" Style="{StaticResource Nav.Item}" GroupName="Nav"
                                 IsChecked="True" Checked="OnNavChecked" Tag="messages">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="💬" Margin="0,0,9,0" FontSize="14" />
                            <TextBlock Text="消息列表" VerticalAlignment="Center" />
                            <Border x:Name="UnreadPill" Background="{DynamicResource Brush.Danger}"
                                    CornerRadius="9" Padding="7,1" Margin="10,0,0,0"
                                    VerticalAlignment="Center" Visibility="Collapsed">
                                <TextBlock x:Name="UnreadPillText" Foreground="#FFFFFF" FontSize="11"
                                           FontWeight="Bold" />
                            </Border>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="NavDevices" Style="{StaticResource Nav.Item}" GroupName="Nav"
                                 Checked="OnNavChecked" Tag="devices">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📡" Margin="0,0,9,0" FontSize="14" />
                            <TextBlock Text="设备状态" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="NavEsim" Style="{StaticResource Nav.Item}" GroupName="Nav"
                                 Checked="OnNavChecked" Tag="esim">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="💳" Margin="0,0,9,0" FontSize="14" />
                            <TextBlock Text="eSIM 管理" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="NavSettings" Style="{StaticResource Nav.Item}" GroupName="Nav"
                                 Checked="OnNavChecked" Tag="settings">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚙" Margin="0,0,9,0" FontSize="14" />
                            <TextBlock Text="设置" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>

                <!-- 底部版本号（三端一致） -->
                <StackPanel Grid.Row="3" Margin="18,0,18,16">
                    <Border Height="1" Background="{DynamicResource Brush.Border}" Margin="0,0,0,12" />
                    <TextBlock x:Name="VersionLabel" Style="{StaticResource Text.Muted}"
                               HorizontalAlignment="Center" FontSize="11.5" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= 右侧内容 ================= -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ContentControl x:Name="PageHost" Grid.Row="0" />

            <!-- 页脚：同样标注版本号 -->
            <Border Grid.Row="1" Padding="22,9" BorderBrush="{DynamicResource Brush.Border}"
                    BorderThickness="0,1,0,0" Background="{DynamicResource Brush.Surface}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="FooterStatusText" Style="{StaticResource Text.Muted}"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="FooterVersionText" Style="{StaticResource Text.Muted}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
