<UserControl x:Class="SmsatBox.Desktop.Views.Pages.DevicesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:SmsatBox.Desktop.Core"
             FontFamily="{DynamicResource Font.Ui}"
             TextOptions.TextFormattingMode="Ideal"
             UseLayoutRounding="True">

    <UserControl.Resources>
        <core:ZeroToVisibleConverter x:Key="ZeroToVisible" />
        <!-- 卡槽条目 -->
        <DataTemplate x:Key="SlotItem">
            <Border Background="{DynamicResource Brush.SurfaceAlt}" CornerRadius="9" Padding="12,9" Margin="0,0,0,7"
                    Opacity="{Binding Opacity, Mode=OneWay}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="26" Height="26" CornerRadius="7"
                            Background="{DynamicResource Brush.AccentSoft}" VerticalAlignment="Center">
                        <TextBlock Text="{Binding SlotIndex}" FontSize="12" FontWeight="Bold"
                                   Foreground="{DynamicResource Brush.Accent}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center">
                        <!-- 标题：优先备注 -->
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding DisplayName, Mode=OneWay}" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Brush.Text}" />
                            <Border CornerRadius="5" Padding="5,0" Margin="7,0,0,0" VerticalAlignment="Center"
                                    Background="{DynamicResource Brush.Surface}">
                                <TextBlock Text="已隐藏" FontSize="9.5" Style="{StaticResource Text.Muted}" />
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Hidden}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                        </StackPanel>

                        <!-- 模组状态徽标 -->
                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                            <TextBlock Text="{Binding Module.StateBadge, Mode=OneWay}"
                                       Style="{StaticResource Text.Muted}" FontSize="11" />
                            <TextBlock Text=" · " Style="{StaticResource Text.Muted}" FontSize="11" />
                            <TextBlock Text="{Binding CarrierLabel, Mode=OneWay}"
                                       Style="{StaticResource Text.Muted}" FontSize="11" />
                            <TextBlock Text=" · " Style="{StaticResource Text.Muted}" FontSize="11" />
                            <TextBlock Text="{Binding Module.SimState, Mode=OneWay}"
                                       Style="{StaticResource Text.Muted}" FontSize="11" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right"
                                Margin="0,0,8,0">
                        <TextBlock Text="{Binding Module.SignalBars, Mode=OneWay}" FontFamily="Segoe UI Symbol"
                                   FontSize="12" Foreground="{DynamicResource Brush.Success}"
                                   HorizontalAlignment="Right" />
                        <TextBlock Text="{Binding Module.SignalText, Mode=OneWay}"
                                   Style="{StaticResource Text.Muted}" FontSize="10.5"
                                   HorizontalAlignment="Right" Margin="0,2,0,0" />
                    </StackPanel>

                    <Button Grid.Column="3" Style="{StaticResource Btn.Small}" Content="编辑"
                            VerticalAlignment="Center" Click="OnEditSlotClick"
                            Tag="{Binding}" />
                </Grid>
            </Border>
        </DataTemplate>

        <!-- 设备卡片 -->
        <DataTemplate x:Key="DeviceCard">
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <!-- 头部 -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Width="38" Height="38" CornerRadius="10"
                                Background="{DynamicResource Brush.SurfaceAlt}" VerticalAlignment="Top">
                            <TextBlock Text="📻" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <StackPanel Grid.Column="1" Margin="12,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding NameLabel}" Style="{StaticResource Text.H2}" />
                                <Border CornerRadius="6" Padding="7,1" Margin="9,0,0,0" VerticalAlignment="Center"
                                        Background="{DynamicResource Brush.AccentSoft}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding OnlineBadge}" FontSize="9"
                                                   Foreground="{DynamicResource Brush.Success}"
                                                   VerticalAlignment="Center" Margin="0,0,4,0" />
                                        <TextBlock Text="{Binding StatusLabel}" FontSize="10.5"
                                                   Foreground="{DynamicResource Brush.Success}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <!-- Run.Text 的默认绑定模式是 TwoWay，这里必须显式 OneWay，
                                 否则会因只读计算属性抛 XamlParseException。 -->
                            <TextBlock Style="{StaticResource Text.Muted}" Margin="0,4,0,0">
                                <Run Text="{Binding NetModeLabel, Mode=OneWay}" />
                                <Run Text=" · IP " />
                                <Run Text="{Binding IpLabel, Mode=OneWay}" />
                                <Run Text=" · 固件 " />
                                <Run Text="{Binding FirmwareVersion, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>

                        <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock Text="{Binding SlotCountLabel}" Style="{StaticResource Text.Sub}" />
                                <TextBlock Text="{Binding ModuleSummary, Mode=OneWay}" Style="{StaticResource Text.Muted}"
                                           FontSize="11" Margin="8,0,0,0" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,5,0,0">
                                <Button Style="{StaticResource Btn.Small}" Content="编辑设备"
                                        Click="OnEditDeviceClick" Tag="{Binding}" Margin="0,0,6,0" />
                                <TextBlock Text="{Binding LastSeenLabel}" Style="{StaticResource Text.Muted}"
                                           VerticalAlignment="Center"
                                           ToolTip="{Binding LastSeenExact}" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <!-- 设备备注 -->
                    <TextBlock Text="{Binding Remark, Mode=OneWay}"
                               FontSize="11.5" Margin="0,9,0,0" TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Muted}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasRemark}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <Border Height="1" Background="{DynamicResource Brush.Border}" Margin="0,13,0,11" />

                    <!-- 卡槽 -->
                    <ItemsControl ItemsSource="{Binding Slots}" ItemTemplate="{StaticResource SlotItem}" />

                    <TextBlock Text="该设备未配置卡槽" Style="{StaticResource Text.Muted}"
                               Visibility="{Binding Slots.Count, Converter={StaticResource ZeroToVisible}}" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="22,18,22,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <StackPanel>
                <TextBlock Text="设备状态" Style="{StaticResource Text.H1}" />
                <TextBlock x:Name="SubtitleText" Style="{StaticResource Text.Muted}" Margin="0,4,0,0" />
            </StackPanel>
            <Button Style="{StaticResource Btn.Base}" Content="刷新" HorizontalAlignment="Right"
                    VerticalAlignment="Center" Click="OnRefreshClick" />
        </Grid>

        <Grid Grid.Row="1" Margin="0,16,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="DeviceList" ItemTemplate="{StaticResource DeviceCard}" Margin="0,0,8,0" />
            </ScrollViewer>

            <StackPanel x:Name="EmptyPanel" VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="📡" FontSize="44" HorizontalAlignment="Center" Opacity="0.6" />
                <TextBlock Text="暂无设备" Style="{StaticResource Text.H2}" HorizontalAlignment="Center"
                           Margin="0,12,0,0" />
                <TextBlock Text="在 Web 管理端添加设备后，这里会显示在线状态与卡槽信息"
                           Style="{StaticResource Text.Muted}" HorizontalAlignment="Center" Margin="0,6,0,0" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
