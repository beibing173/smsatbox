<UserControl x:Class="SmsatBox.Desktop.Views.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{DynamicResource Font.Ui}"
             TextOptions.TextFormattingMode="Ideal"
             UseLayoutRounding="True">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="22,18,22,22" MaxWidth="760" HorizontalAlignment="Left">

            <TextBlock Text="设置" Style="{StaticResource Text.H1}" />
            <TextBlock Text="账号、主题、通知与独立升级" Style="{StaticResource Text.Muted}" Margin="0,4,0,0" />

            <!-- ==== 账号与平台 ==== -->
            <Border Style="{StaticResource Card}" Margin="0,18,0,0">
                <StackPanel>
                    <TextBlock Text="中转平台" Style="{StaticResource Text.H2}" />

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="平台地址" Style="{StaticResource Text.Sub}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" x:Name="ServerUrlText" Style="{StaticResource Text.Base}"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    </Grid>

                    <Grid Margin="0,9,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="当前用户" Style="{StaticResource Text.Sub}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" x:Name="UserText" Style="{StaticResource Text.Base}"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <Grid Margin="0,9,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Token" Style="{StaticResource Text.Sub}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" x:Name="TokenText" Style="{StaticResource Text.Muted}"
                                   FontFamily="{DynamicResource Font.Mono}" VerticalAlignment="Center" />
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <Button Style="{StaticResource Btn.Base}" Content="重新登录 / 更换平台"
                                Click="OnReloginClick" Margin="0,0,8,0" />
                        <Button Style="{StaticResource Btn.Base}" Content="测试连接"
                                Click="OnTestConnectionClick" Margin="0,0,8,0" />
                        <Button Style="{StaticResource Btn.Base}" Content="打开配置文件夹"
                                Click="OnOpenConfigFolderClick" />
                    </StackPanel>

                    <TextBlock x:Name="ConnectionHintText" Style="{StaticResource Text.Muted}"
                               Margin="0,10,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- ==== 外观 ==== -->
            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="外观" Style="{StaticResource Text.H2}" />
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="深色 / 浅色主题" Style="{StaticResource Text.Base}" />
                            <TextBlock Text="切换后立即生效，并记住你的选择" Style="{StaticResource Text.Muted}"
                                       Margin="0,3,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <ToggleButton x:Name="DarkThemeButton" Style="{StaticResource Chip}" Content="🌙 深色"
                                          Margin="0,0,8,0" Click="OnDarkThemeClick" />
                            <ToggleButton x:Name="LightThemeButton" Style="{StaticResource Chip}" Content="☀ 浅色"
                                          Click="OnLightThemeClick" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ==== 通知 ==== -->
            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="通知" Style="{StaticResource Text.H2}" />

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="新消息系统通知" Style="{StaticResource Text.Base}" />
                            <TextBlock Text="新短信 / 未接来电弹出 Windows 原生通知，验证码消息高亮"
                                       Style="{StaticResource Text.Muted}" Margin="0,3,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <ToggleButton Grid.Column="1" x:Name="NotifyToggle" Style="{StaticResource Switch}"
                                      VerticalAlignment="Center" Click="OnNotifyToggleClick" />
                    </Grid>

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="后台轮询间隔" Style="{StaticResource Text.Base}" />
                            <TextBlock Text="每隔多少秒拉取一次新消息（5 - 600 秒）" Style="{StaticResource Text.Muted}"
                                       Margin="0,3,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBox x:Name="PollTextBox" Style="{StaticResource Input}" Width="76"
                                     TextAlignment="Center" LostFocus="OnPollTextBoxLostFocus" />
                            <TextBlock Text="秒" Style="{StaticResource Text.Sub}" Margin="7,0,0,0"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <Button Style="{StaticResource Btn.Base}" Content="发送测试通知" Margin="0,16,0,0"
                            HorizontalAlignment="Left" Click="OnTestNotifyClick" />
                </StackPanel>
            </Border>

            <!-- ==== 窗口行为 ==== -->
            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="窗口与托盘" Style="{StaticResource Text.H2}" />

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="启动时最小化到托盘" Style="{StaticResource Text.Base}" />
                            <TextBlock Text="开机自启时建议开启，不打扰桌面" Style="{StaticResource Text.Muted}"
                                       Margin="0,3,0,0" />
                        </StackPanel>
                        <ToggleButton Grid.Column="1" x:Name="StartMinimizedToggle" Style="{StaticResource Switch}"
                                      VerticalAlignment="Center" Click="OnStartMinimizedToggleClick" />
                    </Grid>

                    <TextBlock Style="{StaticResource Text.Muted}" Margin="0,12,0,0" TextWrapping="Wrap"
                               Text="关闭窗口或最小化时会缩到系统托盘常驻；托盘图标右键可显示主窗口、检查更新或退出。" />
                </StackPanel>
            </Border>

            <!-- ==== 独立升级 ==== -->
            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="独立升级" Style="{StaticResource Text.H2}" />
                    <TextBlock Style="{StaticResource Text.Muted}" Margin="0,6,0,0" TextWrapping="Wrap"
                               Text="直接访问 GitHub Release API 检查新版本，全程不经过 SMSATBOX 中转平台。" />

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="当前版本" Style="{StaticResource Text.Sub}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" x:Name="CurrentVersionText" Style="{StaticResource Text.Base}"
                                   FontWeight="SemiBold" VerticalAlignment="Center" />
                    </Grid>

                    <Grid Margin="0,9,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="更新源" Style="{StaticResource Text.Sub}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" x:Name="RepoText" Style="{StaticResource Text.Muted}"
                                   FontFamily="{DynamicResource Font.Mono}" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <Button x:Name="CheckUpdateButton" Style="{StaticResource Btn.Primary}"
                                Content="检查更新" Click="OnCheckUpdateClick" Margin="0,0,8,0" />
                        <Button x:Name="OpenReleaseButton" Style="{StaticResource Btn.Base}"
                                Content="打开发布页" Click="OnOpenReleaseClick" />
                    </StackPanel>

                    <Border x:Name="UpdateResultBorder" Visibility="Collapsed" Margin="0,14,0,0"
                            CornerRadius="9" Padding="13,11" Background="{DynamicResource Brush.SurfaceAlt}">
                        <StackPanel>
                            <TextBlock x:Name="UpdateResultText" Style="{StaticResource Text.Base}"
                                       TextWrapping="Wrap" />
                            <ProgressBar x:Name="UpdateProgress" Height="4" Margin="0,10,0,0" Minimum="0"
                                         Maximum="100" Visibility="Collapsed"
                                         Foreground="{DynamicResource Brush.Accent}"
                                         Background="{DynamicResource Brush.Border}" BorderThickness="0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ==== 关于 ==== -->
            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="关于" Style="{StaticResource Text.H2}" />
                    <TextBlock x:Name="AboutText" Style="{StaticResource Text.Muted}" Margin="0,10,0,0"
                               TextWrapping="Wrap" LineHeight="20" />
                    <TextBlock x:Name="AboutVersionText" Style="{StaticResource Text.Muted}" Margin="0,10,0,0" />
                    <Button Style="{StaticResource Btn.Base}" Content="打开日志文件夹" Margin="0,13,0,0"
                            HorizontalAlignment="Left" Click="OnOpenLogFolderClick" />
                </StackPanel>
            </Border>

            <!-- 页脚版本号（三端一致） -->
            <TextBlock x:Name="FooterVersionText" Style="{StaticResource Text.Muted}"
                       HorizontalAlignment="Center" Margin="0,22,0,0" FontSize="11.5" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
