<UserControl x:Class="SmsatBox.Desktop.Views.Pages.EsimPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             FontFamily="{DynamicResource Font.Ui}"
             UseLayoutRounding="True">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 页头 -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="eSIM 管理" Style="{StaticResource Text.H1}" />
                <TextBlock x:Name="SubtitleText" Style="{StaticResource Text.Muted}"
                           Margin="0,4,0,0" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="ReloadBtn" Style="{StaticResource Btn.Base}"
                        Content="刷新" Click="OnReloadClick" Margin="0,0,8,0" />
                <Button x:Name="BrowserBtn" Style="{StaticResource Btn.Base}"
                        Content="在浏览器打开" Click="OnBrowserClick" />
            </StackPanel>
        </Grid>

        <!-- WebView2 宿主 -->
        <Border Grid.Row="1" CornerRadius="12" ClipToBounds="True"
                Background="{DynamicResource Brush.Surface}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
            <Grid>
                <wv2:WebView2 x:Name="Web" Visibility="Collapsed" />

                <StackPanel x:Name="HintPanel" VerticalAlignment="Center"
                            HorizontalAlignment="Center">
                    <TextBlock Text="💳" FontSize="40" HorizontalAlignment="Center" Opacity="0.6" />
                    <TextBlock x:Name="HintText" Style="{StaticResource Text.Muted}"
                               HorizontalAlignment="Center" Margin="0,12,0,0"
                               TextWrapping="Wrap" MaxWidth="420" TextAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
