<Window x:Class="SmsatBox.Desktop.Views.EditSlotDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="编辑卡槽"
        Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource Brush.WindowBg}"
        FontFamily="{DynamicResource Font.Ui}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True">

    <StackPanel Margin="24,20,24,18">
        <TextBlock x:Name="HeaderText" Style="{StaticResource Text.H2}" />
        <TextBlock x:Name="ModuleInfoText" Style="{StaticResource Text.Muted}"
                   TextWrapping="Wrap" Margin="0,6,0,0" FontSize="11" />

        <TextBlock Text="备注名称" Style="{StaticResource Text.Sub}" Margin="2,18,0,6" />
        <TextBox x:Name="RemarkBox" Style="{StaticResource Input}" />

        <TextBlock Text="手机号码" Style="{StaticResource Text.Sub}" Margin="2,14,0,6" />
        <TextBox x:Name="NumberBox" Style="{StaticResource Input}" />

        <CheckBox x:Name="VisibleCheck" Content="在消息列表中显示此卡槽"
                  Foreground="{DynamicResource Brush.TextSub}" Margin="2,18,0,0" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
            <Button Style="{StaticResource Btn.Base}" Content="取消" Margin="0,0,9,0"
                    IsCancel="True" Click="OnCancelClick" />
            <Button Style="{StaticResource Btn.Primary}" Content="保存" IsDefault="True"
                    Click="OnSaveClick" />
        </StackPanel>
    </StackPanel>
</Window>
