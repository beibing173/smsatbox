# ==============================================================================
# SMSATBOX Server 环境变量模板 —— 复制为 .env 后修改
# ==============================================================================

# ---------- 安全（务必修改） ----------
# 超级管理员账号
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@123456
ADMIN_DISPLAY_NAME=超级管理员

# JWT 签名密钥；留空则自动生成并持久化到 /data/.secret_key
SECRET_KEY=
# 登录令牌有效期（分钟）
TOKEN_TTL_MINUTES=720

# ---------- 服务 ----------
HTTP_PORT=8080
IMAGE_TAG=1.0.0
DATA_DIR=/data
# 允许跨域的来源，多个用逗号分隔；生产建议写死域名
CORS_ORIGINS=*

# ---------- 设备 ----------
# 设备离线判定阈值（秒）
DEVICE_OFFLINE_SECONDS=90
# 单文件固件大小上限（MB）
MAX_FIRMWARE_MB=16

# ---------- 协同升级（维度二） ----------
# 镜像名，ESP32 请求升级时会参考
SERVER_IMAGE=beibing173/smsatbox-server
# 是否允许 ESP32 触发 Server 自升级（默认关闭，安全优先）
SERVER_UPGRADE_ENABLED=false
# 升级执行命令；容器内需挂载 docker.sock 才能执行
# 示例：docker pull beibing173/smsatbox-server:latest && docker restart smsatbox-server
SERVER_UPGRADE_COMMAND=
