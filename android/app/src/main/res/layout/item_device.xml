<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_card"
    android:padding="14dp"
    android:layout_marginBottom="10dp">

    <!-- 设备名 + 在线状态 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <View
            android:id="@+id/onlineDot"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="@drawable/bg_dot_offline" />

        <TextView
            android:id="@+id/deviceName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/text_0"
            android:layout_marginStart="8dp"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/onlineText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textColor="@color/text_2"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:background="@drawable/bg_tag" />
    </LinearLayout>

    <!-- 状态信息网格 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="11dp">

        <LinearLayout style="@style/StatCell">
            <TextView style="@style/StatLabel" android:text="固件" />
            <TextView android:id="@+id/firmwareText" style="@style/StatValue"
                android:textSize="13sp" android:text="v-" />
        </LinearLayout>

        <LinearLayout style="@style/StatCell">
            <TextView style="@style/StatLabel" android:text="网络" />
            <TextView android:id="@+id/netModeText" style="@style/StatValue"
                android:textSize="13sp" android:text="-" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="6dp">

        <LinearLayout style="@style/StatCell">
            <TextView style="@style/StatLabel" android:text="局域网 IP" />
            <TextView android:id="@+id/ipText" style="@style/StatValue"
                android:textSize="13sp" android:text="-" />
        </LinearLayout>

        <LinearLayout style="@style/StatCell">
            <TextView style="@style/StatLabel" android:text="WiFi 信号" />
            <TextView android:id="@+id/rssiText" style="@style/StatValue"
                android:textSize="13sp" android:text="-" />
        </LinearLayout>
    </LinearLayout>

    <!-- 卡槽列表 -->
    <LinearLayout
        android:id="@+id/slotContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="10dp" />

</LinearLayout>
