<?xml version="1.0" encoding="utf-8"?>
<!--
  主界面布局：悬空式底部导航（参考 FlClash 的 navigation dock 设计）

  设计要点（液态玻璃质感）：
    1. 导航栏不再贴底贴边，而是左右留白 16dp、底部留白 12dp 悬浮着
    2. 大圆角 26dp + 柔和阴影，像一块浮在内容上的玻璃
    3. 半透明背景（nav_glass），底下的内容能隐约透出来
    4. 1dp 高光描边，模拟玻璃边缘反光
    5. 内容区不再被分隔线切断，列表可以一直滚到导航栏下面
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_0">

    <!-- 内容区：铺满整个屏幕，导航栏浮在它上层 -->
    <FrameLayout
        android:id="@+id/container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- 版本号：悬浮在导航栏上方，极低存在感 -->
    <TextView
        android:id="@+id/versionText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="v1.0.3"
        android:textSize="9sp"
        android:letterSpacing="0.05"
        android:textColor="@color/text_2"
        android:alpha="0.55"
        android:layout_marginBottom="2dp"
        app:layout_constraintBottom_toTopOf="@id/navCard"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 悬空导航 Dock（液态玻璃） -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/navCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="18dp"
        android:layout_marginBottom="14dp"
        app:cardCornerRadius="28dp"
        app:cardElevation="10dp"
        app:cardBackgroundColor="@color/nav_glass"
        app:strokeWidth="1dp"
        app:strokeColor="@color/nav_glass_stroke"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/navView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            app:elevation="0dp"
            app:itemIconTint="@color/nav_item_color"
            app:itemTextColor="@color/nav_item_color"
            app:itemActiveIndicatorStyle="@style/NavActiveIndicator"
            app:itemIconSize="22dp"
            app:labelVisibilityMode="labeled"
            app:menu="@menu/bottom_nav" />

    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
