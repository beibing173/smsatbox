<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      浅色主题（系统默认 / values 目录）
      Android 约定：
        values/colors.xml        → 浅色（默认，无深色资源时也用这个）
        values-night/colors.xml  → 深色（系统夜间模式时自动选用）
      配合 AppCompatDelegate.setDefaultNightMode 实现「跟随系统 / 深色 / 浅色」三模式。
    -->
    <color name="bg_0">#F4F7FB</color>
    <color name="bg_1">#FFFFFF</color>
    <color name="surface">#FFFFFF</color>
    <color name="surface_2">#F4F7FB</color>
    <color name="line">#D8E0EC</color>
    <color name="line_soft">#E7EDF5</color>

    <color name="text_0">#10192B</color>
    <color name="text_1">#4A5A72</color>
    <color name="text_2">#8394A8</color>

    <color name="brand">#0891B2</color>
    <color name="brand_2">#4F46E5</color>
    <color name="ok">#10B981</color>
    <color name="warn">#B45309</color>
    <color name="danger">#DC2626</color>

    <color name="code_bg">#E3F7FB</color>
    <color name="code_line">#7FCBDC</color>
    <color name="code_text">#0B6F86</color>

    <color name="nav_unselected">#8394A8</color>
    <color name="nav_selected">#0891B2</color>
    <!-- 悬空导航 Dock：液态玻璃 -->
    <color name="nav_glass">#F0FFFFFF</color>
    <color name="nav_glass_stroke">#40FFFFFF</color>
    <color name="nav_indicator">#1F0891B2</color>
    <!-- 悬空 Dock 渐变玻璃（顶部受光 / 底部略暗） -->
    <color name="nav_glass_top">#F5FFFFFF</color>
    <color name="nav_glass_bottom">#E8F1F5FB</color>
</resources>
