# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---- 运行数据 ----
# 注意：只忽略真正存放运行数据的目录，不要写裸 "data/"
# 否则会把 Android 的 app/src/main/java/.../data 包目录一起吃掉
server/data/
*.db
*.db-wal
*.db-shm
*.bin

# ---- 环境 ----
.env
!.env.example

# ---- Android ----
android/.gradle/
android/build/
android/app/build/
android/local.properties
android/keystore/
android/*.jks
android/*.keystore
android/version.properties

# ---- ESP32 / PlatformIO ----
esp32/.pio/
esp32/.pio-*
.pio-venv/
.pio/
*.pio.ini.bak

# ---- Windows / .NET ----
windows/**/bin/
windows/**/obj/
windows/dist/
dist/
*.user
*.suo

# ---- 前端/构建产物 ----
node_modules/
**/dist/

# ---- 系统 ----
.DS_Store
Thumbs.db
.idea/
.vscode/
*.log

# ---- 本地截图 / 临时 ----
.shots/
versions/.snapshot-*
